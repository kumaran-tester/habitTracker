<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Habit Tracker</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        sans-serif;
    }

    body {
      min-height: 100vh;
      background: #0f172a;
      color: #e5e7eb;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 24px;
    }

    .app {
      width: 100%;
      max-width: 900px;
      background: #020617;
      border-radius: 16px;
      padding: 24px 20px 28px;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
      border: 1px solid #1f2937;
    }

    .app-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
    }

    .app-header h1 {
      font-size: 1.6rem;
      letter-spacing: 0.04em;
    }

    .app-header span {
      display: inline-block;
      margin-top: 4px;
      font-size: 0.9rem;
      color: #9ca3af;
    }

    .today {
      text-align: right;
      font-size: 0.9rem;
      color: #9ca3af;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      background: #111827;
      border: 1px solid #1f2937;
      font-size: 0.8rem;
    }

    .badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: #22c55e;
    }

    .habit-form {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 18px;
      padding: 10px 12px;
      border-radius: 12px;
      background: #020617;
      border: 1px solid #1f2937;
    }

    .habit-form input[type="text"] {
      flex: 1 1 180px;
      border-radius: 999px;
      border: 1px solid #374151;
      padding: 8px 12px;
      background: #020617;
      color: #e5e7eb;
      font-size: 0.95rem;
    }

    .habit-form input[type="text"]::placeholder {
      color: #6b7280;
    }

    .habit-form select {
      border-radius: 999px;
      border: 1px solid #374151;
      padding: 8px 12px;
      background: #020617;
      color: #e5e7eb;
      font-size: 0.9rem;
    }

    .btn {
      border-radius: 999px;
      border: none;
      padding: 8px 16px;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s ease, transform 0.05s ease,
        box-shadow 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-primary {
      background: linear-gradient(135deg, #22c55e, #16a34a);
      color: #022c22;
      box-shadow: 0 10px 25px rgba(34, 197, 94, 0.25);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #4ade80, #22c55e);
      transform: translateY(-1px);
      box-shadow: 0 12px 30px rgba(34, 197, 94, 0.3);
    }

    .btn-ghost {
      background: transparent;
      color: #9ca3af;
      border: 1px solid #374151;
    }

    .btn-ghost:hover {
      background: #020617;
      color: #e5e7eb;
    }

    .habit-table-wrapper {
      border-radius: 14px;
      border: 1px solid #1f2937;
      overflow: auto;
      background: radial-gradient(circle at top left, #0b1120, #020617);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 650px;
    }

    thead {
      background: rgba(15, 23, 42, 0.95);
      position: sticky;
      top: 0;
      z-index: 1;
    }

    th,
    td {
      padding: 10px 10px;
      text-align: center;
      font-size: 0.9rem;
      border-bottom: 1px solid rgba(31, 41, 55, 0.8);
    }

    th:first-child,
    td:first-child {
      text-align: left;
      padding-left: 14px;
    }

    th {
      font-weight: 500;
      color: #9ca3af;
      white-space: nowrap;
    }

    tbody tr:nth-child(odd) {
      background: rgba(15, 23, 42, 0.7);
    }

    tbody tr:nth-child(even) {
      background: rgba(15, 23, 42, 0.4);
    }

    tbody tr:hover {
      background: rgba(30, 64, 175, 0.25);
    }

    .habit-title {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .habit-color {
      width: 8px;
      height: 24px;
      border-radius: 999px;
      opacity: 0.9;
    }

    .habit-meta {
      font-size: 0.75rem;
      color: #9ca3af;
      margin-top: 2px;
    }

    .day-label {
      font-size: 0.8rem;
      display: block;
      color: #6b7280;
    }

    input[type="checkbox"] {
      width: 18px;
      height: 18px;
      cursor: pointer;
      accent-color: #22c55e;
    }

    .streak-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(22, 163, 74, 0.1);
      color: #bbf7d0;
      font-size: 0.8rem;
      border: 1px solid rgba(34, 197, 94, 0.5);
    }

    .streak-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: #22c55e;
    }

    .delete-btn {
      background: transparent;
      border: none;
      color: #f97373;
      cursor: pointer;
      font-size: 1rem;
      padding: 4px 8px;
      border-radius: 999px;
      transition: background 0.15s ease, transform 0.05s ease;
    }

    .delete-btn:hover {
      background: rgba(248, 113, 113, 0.1);
      transform: translateY(-1px);
    }

    .footer {
      margin-top: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
      color: #6b7280;
      gap: 10px;
      flex-wrap: wrap;
    }

    .footer strong {
      color: #e5e7eb;
    }

    @media (max-width: 640px) {
      .app {
        padding: 18px 14px 22px;
      }
      .app-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .today {
        text-align: left;
      }
      .habit-form {
        flex-direction: column;
      }
      .habit-form input[type="text"],
      .habit-form select,
      .habit-form .btn {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <div class="app">
    <header class="app-header">
      <div>
        <h1>Habit Tracker</h1>
        <span>Build small, consistent routines every day</span>
      </div>
      <div class="today">
        <div class="badge">
          <span class="badge-dot"></span>
          <span id="todayText"></span>
        </div>
      </div>
    </header>

    <section class="habit-form">
      <input
        type="text"
        id="habitNameInput"
        placeholder="Add a new habit (e.g. Read 20 minutes)"
      />
      <select id="frequencySelect">
        <option value="daily">Daily</option>
        <option value="weekdays">Weekdays</option>
        <option value="custom">Custom (7-day)</option>
      </select>
      <button class="btn btn-primary" id="addHabitBtn">
        + Add habit
      </button>
      <button class="btn btn-ghost" id="clearAllBtn">
        Clear all data
      </button>
    </section>

    <section class="habit-table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Habit</th>
            <th>
              Mon
              <span class="day-label">1</span>
            </th>
            <th>
              Tue
              <span class="day-label">2</span>
            </th>
            <th>
              Wed
              <span class="day-label">3</span>
            </th>
            <th>
              Thu
              <span class="day-label">4</span>
            </th>
            <th>
              Fri
              <span class="day-label">5</span>
            </th>
            <th>
              Sat
              <span class="day-label">6</span>
            </th>
            <th>
              Sun
              <span class="day-label">7</span>
            </th>
            <th>Streak</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="habitTableBody"></tbody>
      </table>
    </section>

    <footer class="footer">
      <span>
        <strong id="completedCount">0</strong> / 
        <span id="totalCheckCount">0</span> checks completed this week
      </span>
      <span>Data is stored locally in your browser (no backend required).</span>
    </footer>
  </div>

  <script>
    const DAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"];
    const STORAGE_KEY = "habit-tracker-v1";

    function generateId() {
      return Date.now().toString(36) + Math.random().toString(36).slice(2);
    }

    const COLORS = ["#22c55e", "#0ea5e9", "#a855f7", "#f97316", "#facc15"];
    function colorForIndex(i) {
      return COLORS[i % COLORS.length];
    }

    function loadHabits() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return [];
      try {
        return JSON.parse(raw);
      } catch (e) {
        return [];
      }
    }

    function saveHabits(habits) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(habits));
    }

    function getWeekStart(date = new Date()) {
      const d = new Date(date);
      const day = (d.getDay() + 6) % 7;
      d.setHours(0, 0, 0, 0);
      d.setDate(d.getDate() - day);
      return d.toISOString().slice(0, 10);
    }

    function ensureWeek(habits) {
      const currentWeek = getWeekStart();
      return habits.map((h) => {
        if (!h.weeks || !h.weeks[currentWeek]) {
          if (!h.weeks) h.weeks = {};
          h.weeks[currentWeek] = {
            mon: false,
            tue: false,
            wed: false,
            thu: false,
            fri: false,
            sat: false,
            sun: false,
          };
        }
        return h;
      });
    }

    let habits = ensureWeek(loadHabits());

    const todayText = document.getElementById("todayText");
    const habitNameInput = document.getElementById("habitNameInput");
    const frequencySelect = document.getElementById("frequencySelect");
    const addHabitBtn = document.getElementById("addHabitBtn");
    const clearAllBtn = document.getElementById("clearAllBtn");
    const habitTableBody = document.getElementById("habitTableBody");
    const completedCountEl = document.getElementById("completedCount");
    const totalCheckCountEl = document.getElementById("totalCheckCount");

    function renderToday() {
      const d = new Date();
      const options = {
        weekday: "short",
        month: "short",
        day: "numeric",
      };
      todayText.textContent = d.toLocaleDateString(undefined, options);
    }

    function calcStreak(weekData) {
      let current = 0;
      for (const day of DAYS) {
        if (weekData[day]) current++;
        else current = 0;
      }
      return current;
    }

    function renderTable() {
      const currentWeek = getWeekStart();
      habitTableBody.innerHTML = "";

      let completedChecks = 0;
      let totalChecks = 0;

      habits.forEach((habit, index) => {
        const weekData = habit.weeks[currentWeek];
        const row = document.createElement("tr");

        const titleTd = document.createElement("td");
        const titleWrap = document.createElement("div");
        titleWrap.className = "habit-title";

        const colorBar = document.createElement("div");
        colorBar.className = "habit-color";
        colorBar.style.background = colorForIndex(index);

        const titleText = document.createElement("div");
        titleText.innerHTML = `
          <div>${habit.name}</div>
          <div class="habit-meta">${habit.frequency} habit</div>
        `;

        titleWrap.appendChild(colorBar);
        titleWrap.appendChild(titleText);
        titleTd.appendChild(titleWrap);
        row.appendChild(titleTd);

        DAYS.forEach((dayKey) => {
          const td = document.createElement("td");
          const cb = document.createElement("input");
          cb.type = "checkbox";
          cb.checked = weekData[dayKey];
          cb.dataset.habitId = habit.id;
          cb.dataset.dayKey = dayKey;
          cb.addEventListener("change", handleCheckboxChange);
          td.appendChild(cb);
          row.appendChild(td);

          totalChecks++;
          if (cb.checked) completedChecks++;
        });

        const streakTd = document.createElement("td");
        const streak = calcStreak(weekData);
        const streakDiv = document.createElement("div");
        streakDiv.className = "streak-pill";
        streakDiv.innerHTML = `
          <span class="streak-dot"></span>
          <span>${streak} day streak</span>
        `;
        streakTd.appendChild(streakDiv);
        row.appendChild(streakTd);

        const actionsTd = document.createElement("td");
        const delBtn = document.createElement("button");
        delBtn.className = "delete-btn";
        delBtn.textContent = "✕";
        delBtn.title = "Delete habit";
        delBtn.dataset.habitId = habit.id;
        delBtn.addEventListener("click", handleDeleteHabit);
        actionsTd.appendChild(delBtn);
        row.appendChild(actionsTd);

        habitTableBody.appendChild(row);
      });

      completedCountEl.textContent = completedChecks;
      totalCheckCountEl.textContent = totalChecks;
    }

    function handleCheckboxChange(e) {
      const habitId = e.target.dataset.habitId;
      const dayKey = e.target.dataset.dayKey;
      const checked = e.target.checked;
      const currentWeek = getWeekStart();

      habits = habits.map((h) => {
        if (h.id !== habitId) return h;
        if (!h.weeks[currentWeek]) {
          h.weeks[currentWeek] = {
            mon: false,
            tue: false,
            wed: false,
            thu: false,
            fri: false,
            sat: false,
            sun: false,
          };
        }
        h.weeks[currentWeek][dayKey] = checked;
        return h;
      });

      saveHabits(habits);
      renderTable();
    }

    function handleDeleteHabit(e) {
      const habitId = e.target.dataset.habitId;
      if (!confirm("Delete this habit?")) return;
      habits = habits.filter((h) => h.id !== habitId);
      saveHabits(habits);
      renderTable();
    }

    function handleAddHabit() {
      const name = habitNameInput.value.trim();
      const frequency = frequencySelect.value;

      if (!name) {
        alert("Please enter a habit name.");
        return;
      }

      const currentWeek = getWeekStart();
      const newHabit = {
        id: generateId(),
        name,
        frequency,
        weeks: {
          [currentWeek]: {
            mon: false,
            tue: false,
            wed: false,
            thu: false,
            fri: false,
            sat: false,
            sun: false,
          },
        },
      };

      habits.push(newHabit);
      saveHabits(habits);
      habitNameInput.value = "";
      renderTable();
    }

    function handleClearAll() {
      if (!confirm("Clear all habits and progress?")) return;
      habits = [];
      localStorage.removeItem(STORAGE_KEY);
      renderTable();
    }

    addHabitBtn.addEventListener("click", handleAddHabit);
    habitNameInput.addEventListener("keyup", (e) => {
      if (e.key === "Enter") handleAddHabit();
    });
    clearAllBtn.addEventListener("click", handleClearAll);

    renderToday();
    habits = ensureWeek(habits);
    renderTable();
  </script>
</body>
</html>
